client.models()

surface_tension = 0.01
delta_mu_RESET_J = 65e8  # [GJ/m^3]
pi = np.pi

###_____Electric Conductivity_____###
alpha_fil = -0.04
alpha_gap = 0.04
EC_HfO2x=8e3
EC_gap=1.5e1
